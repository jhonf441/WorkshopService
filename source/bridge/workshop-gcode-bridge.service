[Unit]
Description=Workshop G-code bridge: G-code over TCP (Telnet style) to the Duet for external programs, terminals, scripts, ESP32
After=network-online.target duetcontrolserver.service
Wants=network-online.target
Requires=duetcontrolserver.service

[Service]
Type=simple
# install.sh replaces __USER__, __DIR__ and __SD__
User=__USER__
# No Group=dsf on purpose: DSF treats every process whose primary group is dsf as a
# PLUGIN ("Failed to find plugin permissions") and cuts it. The user is already in
# the dsf group as a secondary group (DSF socket and write access to the SD).
ExecStart=/usr/bin/python3 -u __DIR__/gcode_bridge.py
# The page turns the bridge off by creating this flag (and stopping the unit): then it does not come back at boot.
# Turning it on removes the flag. Exit code 1 here = "skipped", not a failure.
ExecCondition=/usr/bin/test ! -e __SD__/sys/workshop/data/bridge-disabled
Restart=always
RestartSec=3
# Port 23 (or any port < 1024) without being root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0002

[Install]
WantedBy=multi-user.target
