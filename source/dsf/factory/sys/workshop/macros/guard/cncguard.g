; cncguard.g -- GUARD of the CNC jobs generated by the Workbench
; (Zones page -> "CNC toolpaths" card). It is the FIRST code line of those
; jobs: if anything is not right it aborts and the whole job is cancelled
; before the spindle is started (the abort of a macro called from a job
; cancels the job: checked live 2026-10-08 with cutguard.g).
;
; Use:  M98 P"0:/sys/workshop/macros/guard/cncguard.g" D6 H5
;       D = deepest pass of the job below Z0 (mm, positive)   H = safe height above Z0 (mm)
; (never P for a value: in M98 the P is the file name.)
; Without the permission of the page (jobarm.g) it aborts: the spindle is not started and the job is cancelled.
;
; The same pattern as sys/workshop/macros/guard/cutguard.g (laser): what is checked
; is that the machine is ready: real CNC mode (M453), X/Y/Z homed, the Z0 of
; the active work system set on the material (its offset is not 0) and, with
; D / H, that the job fits in the Z travel at that Z0.
;
; And who started it: the file of the page sits in 0:/gcodes/, where DWC (Files, Jobs) can launch it without the checks the page
; makes at Start (work area, clamps, file older than the design, safety list). So the FIRST thing asked here is the permission
; the Start of the page gives with jobarm.g (K"CNC") right before its M32 (global.workshopCncArmed, 30 s). It is used up here whatever
; happens next: every launch needs its own Start of the page.

var armed = exists(global.workshopCncArmed) ? global.workshopCncArmed : 0   ; uptime second until which the Start of the page allows ONE launch (0 = none, see jobarm.g)
if exists(global.workshopCncArmed)
    set global.workshopCncArmed = 0   ; used up (or not armed: nothing changes): the next launch asks the page again
var en = exists(global.workshopLanguage) ? (global.workshopLanguage == "en") : false   ; messages in English (DWC language, see sys/workshop/macros/system/language.g)
if var.armed == 0
    ; RRF rejects an argument over 255 characters ("Keyword argument too long"): the message is built from two short expressions
    var m1 = var.en ? "CNC: this file was not started from the Workbench page. Press Start in Workbench > CNC toolpaths" : "CNC: este archivo no se inicio desde la pagina Mesa de trabajo. Pulsa Iniciar en Mesa de trabajo > Trayectorias CNC"
    var m2 = var.en ? "(it checks the area, the clamps and the safety list). The spindle was not started." : "(revisa el area, las mordazas y la lista de seguridad). No se encendio el husillo."
    abort {var.m1 ^ " " ^ var.m2}
if state.upTime > var.armed
    ; RRF rejects an argument over 255 characters ("Keyword argument too long"): the message is built from two short expressions
    var m1 = var.en ? "CNC: the Start of the Workbench page expired (30 s) before the file began. Press Start again." : "CNC: el Iniciar de la pagina Mesa de trabajo caduco (30 s) antes de que empezara el archivo. Pulsa Iniciar otra vez."
    var m2 = var.en ? "The spindle was not started." : "No se encendio el husillo."
    abort {var.m1 ^ " " ^ var.m2}
var modo = exists(global.selectedMode) ? global.selectedMode : state.machineMode   ; machine mode (global.selectedMode if it exists; otherwise the RRF one)
if var.modo != "CNC"
    abort {var.en ? ("CNC: the machine is not in CNC mode. The spindle was not started.") : ("CNC: la maquina no esta en modo CNC. No se encendio el husillo.")}
if state.machineMode != "CNC"
    abort {var.en ? ("CNC: the firmware is not in CNC mode (M453). The spindle was not started.") : ("CNC: el firmware no esta en modo CNC (M453). No se encendio el husillo.")}
if !move.axes[0].homed || !move.axes[1].homed || !move.axes[2].homed
    abort {var.en ? ("CNC: home X, Y and Z first.") : ("CNC: primero hace homing de X, Y y Z.")}
var z0 = move.axes[2].workplaceOffsets[move.workplaceNumber]   ; Z0 of the active work system, in machine mm
if var.z0 == 0
    abort {var.en ? ("CNC: set the Z zero on the material first (Z0 here).") : ("CNC: primero fija el cero de Z sobre el material (Z0 aqui).")}
var below = var.z0 - move.axes[2].min   ; mm of travel below Z0
var above = move.axes[2].max - var.z0   ; mm of travel above Z0
if exists(param.D) && param.D > var.below
    abort {var.en ? ("CNC: depth " ^ param.D ^ " mm does not fit below this Z0 (" ^ var.below ^ " mm of travel).") : ("CNC: la profundidad " ^ param.D ^ " mm no cabe bajo este Z0 (" ^ var.below ^ " mm de recorrido).")}
if exists(param.H) && param.H > var.above
    abort {var.en ? ("CNC: safe height " ^ param.H ^ " mm is above the Z top at this Z0 (" ^ var.above ^ " mm left).") : ("CNC: la altura segura " ^ param.H ^ " mm supera el tope de Z con este Z0 (" ^ var.above ^ " mm libres).")}
